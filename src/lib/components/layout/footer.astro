---
const year = new Date().getFullYear();

import { Logo } from '$lib/components/ui';
import {
  FooterNavigation,
  SocialMediaNavigation,
} from '$lib/components/navigation';
import FooterScript from '$lib/components/layout/footer-script.astro';
---

<footer class="full-width py-10 bg-(--surface-container-low) mt-auto">
  <div class="content-width px-4 lg:px-0">
    <!-- Top: logo + nav -->
    <div
      class="flex flex-col items-center sm:flex-row sm:items-start sm:justify-between gap-6 mb-8"
    >
      <Logo />
      <FooterNavigation />
    </div>

    <!-- Divider -->
    <div class="w-full h-px bg-(--outline-variant) mb-6"></div>

    <!-- Bottom: social + copyright -->
    <div
      class="flex flex-col items-center sm:flex-row sm:items-center sm:justify-between gap-4"
    >
      <div class="flex flex-row gap-4">
        <SocialMediaNavigation />
      </div>

      <p
        class="text-xs tracking-tight text-(--on-surface-variant) text-center sm:text-right"
      >
        © {year} Saurab Gupta
        <span class="text-(--outline-variant) mx-1.5">·</span>
        Crafted with precision
      </p>
    </div>
  </div>
</footer>
<FooterScript />
