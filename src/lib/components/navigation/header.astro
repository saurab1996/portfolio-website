---
import { Button } from '$lib/components/ui';

const { currentPath, class: className } = Astro.props;

const navLinks = [
  // { href: '/about', label: 'ABOUT' },
  // { href: '/technical', label: 'STACK' },
  { href: '/projects', label: 'PROJECTS' },
  { href: '/blogs', label: 'BLOG' },
  { href: '/contact', label: 'CONTACT' },
];
---

<nav class={className || ''} aria-label="Main navigation">
  {
    navLinks.map((link) => (
      <Button
        variant="nav"
        href={link.href}
        aria-current={currentPath === link.href ? 'page' : undefined}
        class={`font-medium text-sm tracking-wide transition-colors duration-200 text-foreground ${
          currentPath === link.href
            ? 'text-primary'
            : 'text-foreground hover:text-primary'
        }`}
      >
        {link.label}
      </Button>
    ))
  }
</nav>
