---
import Server from '@lucide/astro/icons/server';
import Cloud from '@lucide/astro/icons/cloud';
import Database from '@lucide/astro/icons/database';
import Code from '@lucide/astro/icons/code';
import GitBranch from '@lucide/astro/icons/git-branch';
import Boxes from '@lucide/astro/icons/boxes';
import Workflow from '@lucide/astro/icons/workflow';
import HardDrive from '@lucide/astro/icons/hard-drive';
import Zap from '@lucide/astro/icons/zap';
import Globe from '@lucide/astro/icons/globe';
import Wrench from '@lucide/astro/icons/wrench';
import BarChart3 from '@lucide/astro/icons/chart-bar';
import Tags from '@lucide/astro/icons/tags';
import Search from '@lucide/astro/icons/search';
import Braces from '@lucide/astro/icons/braces';
import Activity from '@lucide/astro/icons/activity';
import MapIcon from '@lucide/astro/icons/map';
import Cpu from '@lucide/astro/icons/cpu';
import Repeat from '@lucide/astro/icons/repeat';
import ClipboardList from '@lucide/astro/icons/clipboard-list';
import Calendar from '@lucide/astro/icons/calendar';
import CheckCircle from '@lucide/astro/icons/circle-check';
import ShoppingCart from '@lucide/astro/icons/shopping-cart';

import { GlassCard } from '$lib/components/ui';
import type { SkillCategory } from '$lib/types/general.types';
import type { AstroComponent } from 'node_modules/@lucide/astro/src/types';

export type Skill = {
  name: string;
  icon: AstroComponent;
};

export type SkillGroup = {
  category: SkillCategory;
  skills: Skill[];
};

const skillGroups:SkillGroup[] = [
  {
    category: 'Backend',
    skills: [
      { name: 'PHP / Laravel', icon: Code },
      { name: 'WordPress (Core/Custom)', icon: Server },
      { name: 'Node.js / Express', icon: Code },
      { name: 'MySQL / PostgreSQL', icon: Database },
      { name: 'Woocommere', icon: ShoppingCart },
      { name: 'Redis', icon: Zap },
      { name: 'Memcached', icon: HardDrive },
    ],
  },
  {
    category: 'Frontend',
    skills: [
      { name: 'React / Next.js', icon: Code },
      { name: 'Svelte', icon: Code },
      { name: 'Astro', icon: Code },
      { name: 'React / Next.js', icon: Code },
      { name: 'TypeScript', icon: Code },
      { name: 'Tailwind CSS', icon: Code },
      { name: 'Bootstrap CSS', icon: Code },
    ],
  },
  {
    category: 'DevOps',
    skills: [
      { name: 'AWS', icon: Cloud },
      { name: 'Cloudflare (CDN, R2, Workers)', icon: Globe },
      { name: 'Docker', icon: Boxes },
      { name: 'Kubernetes', icon: Boxes },
      { name: 'CI/CD Pipelines', icon: Workflow },
      { name: 'Jenkins', icon: Wrench },
    ],
  },
  {
    category: 'SEO & Analytics',
    skills: [
      { name: 'Programmatic SEO', icon: Cpu },
      { name: 'Google Analytics (GA4)', icon: BarChart3 },
      { name: 'Google Tag Manager (GTM)', icon: Tags },
      { name: 'Google Search Console (GSC)', icon: Search },
      { name: 'XML Sitemap Generation', icon: MapIcon },
      { name: 'Structured Data (Schema.org)', icon: Braces },
      { name: 'Technical SEO (CWV, Indexing)', icon: Activity },
    ],
  },

  {
    category: 'Workflow & Collaboration',
    skills: [
      { name: 'Agile (Scrum/Kanban)', icon: Repeat },
      { name: 'Jira (Project Tracking)', icon: ClipboardList },
      { name: 'Sprint Planning & Estimation', icon: Calendar },
      { name: 'Code Reviews', icon: CheckCircle },
    ],
  },
  {
    category: 'Version Control',
    skills: [
      { name: 'Git / GitHub', icon: GitBranch },
      { name: 'Bitbucket', icon: GitBranch },
      { name: 'GitLab', icon: GitBranch },
    ],
  },
];
---

<section id="skills">
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10 md:mb-12 lg:mb-16">
    <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight">
      Skills & Technologies
    </h2>

    <div class="hidden md:block flex-1 h-px mx-8 bg-linear-to-r from-transparent via-gray-300 to-transparent opacity-60"></div>
  </div>

  <!-- Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
    {skillGroups.map((group) => (
      <GlassCard class="p-5 md:p-6 flex flex-col gap-3" as="div">
        
        <!-- Category -->
        <div class="text-xs font-bold tracking-[0.18em] uppercase mb-3">
          {group.category}
        </div>

        <!-- Skills -->
        <ul class="space-y-2 text-sm text-on-surface font-medium">
          {group.skills.map((skill) => {
            const Icon = skill.icon;

            return (
              <li class="flex items-center gap-2">
                {Icon ? (
                  <Icon class="w-4 h-4 text-primary shrink-0" />
                ) : (
                  <span class="w-1 h-1 bg-primary rounded-full" />
                )}
                <span>{skill.name}</span>
              </li>
            );
          })}
        </ul>

      </GlassCard>
    ))}
  </div>
</section>
